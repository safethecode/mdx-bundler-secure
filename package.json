{
  "name": "mdx-bundler-secure",
  "version": "2.0.0",
  "description": "Compile and bundle your MDX files and their dependencies. FAST. Security-hardened fork of mdx-bundler with RCE mitigation (CVE-2026-0969).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "keywords": [
    "mdx",
    "bundler",
    "mdx-bundler",
    "esbuild",
    "security",
    "rce",
    "cve-2026-0969"
  ],
  "author": "Aaron Son <aaron@safethecode.com> (https://github.com/safethecode)",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/safethecode/mdx-bundler-secure"
  },
  "bugs": {
    "url": "https://github.com/safethecode/mdx-bundler-secure/issues"
  },
  "homepage": "https://github.com/safethecode/mdx-bundler-secure#readme",
  "files": [
    "dist",
    "client",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node ./other/build.js && tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "setup": "npm ci && npm run validate -s",
    "test": "c8 -r text -r lcov uvu -i setup-tests.js src/__tests__",
    "test:package": "tsc --project other/tsconfig.consumer.json && node ./other/smoke-test.cjs",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit",
    "prepublishOnly": "npm run validate",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package && npm run audit"
  },
  "dependencies": {
    "@esbuild-plugins/node-resolve": "^0.2.2",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@mdx-js/esbuild": "^3.1.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.2",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "smol-toml": "^1.9.1",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "esbuild": ">=0.25.0 <1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/react": "^14.1.0",
    "@testing-library/vue": "8.1.0",
    "@types/js-yaml": "^3.12.10",
    "@types/jsdom": "^21.1.5",
    "@types/mdx": "^2.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "hono": "^4.13.17",
    "jsdom": "^22.1.0",
    "left-pad": "^1.3.0",
    "mdx-test-data": "^1.0.1",
    "preact": "^10.29.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-mdx-images": "^3.0.0",
    "typescript": "^5.9.3",
    "uvu": "^0.5.6",
    "vue": "^3.5.45"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.7"
  }
}
