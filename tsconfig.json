{
  "compilerOptions": {
    "rootDir": "src",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {"remark-mdx-images": ["./src/remark-mdx-images.d.ts"]},
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "react", "react-dom"],
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
